{
  "buildCommand": "cd frontend && npm install && npm run build",
  "functions": {
    "api/main.py": {
      "maxDuration": 30,
      "includeFiles": "backend/**,frontend/dist/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/main.py" },
    { "source": "/(.*)", "destination": "/api/main.py" }
  ]
}
