{
  "buildCommand": "cd frontend && npm install && npm run build",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": [
        "backend/**",
        "frontend/dist/**"
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py" }
  ]
}
