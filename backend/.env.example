DATABASE_URL=postgresql+psycopg2://tarot_user:tarot_pass@postgres:5432/tarot_db
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SECRET_KEY=change-this-to-a-random-secret-key-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# ── Zalo Official Account (Optional) ──
# Bật tính năng gửi thông báo Zalo khi đặt lịch, nhắc lịch, v.v.
# Bỏ qua nếu chưa có — toàn bộ module sẽ tự disable.
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=
ZALO_OA_APP_ID=
ZALO_OA_SECRET_KEY=
ZALO_OA_OWNER_USER_ID=
# Scheduler reminder
ZALO_SCHEDULER_ENABLED=1
ZALO_REMINDER_HOURS_BEFORE=2

# Generate ADMIN_PASSWORD_HASH with:
# python -c "from passlib.context import CryptContext; p=CryptContext(schemes=['bcrypt']); print(p.hash('your-password'))"
